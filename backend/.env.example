# ---- Backend environment (set these in Dokploy → application → Environment) ----

# Core
NODE_ENV=production
PORT=3050

# Database (use your managed Mongo or the Dokploy service hostname)
MONGO_URI=mongodb://user:pass@mongodb:27017
DB_NAME=whatsapp-campaigner

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# CORS — leave EMPTY for the same-origin deploy (the reverse proxy routes
# /api on the SPA's own domain to this service, so there is no cross-origin
# request to allow). Only set it if the SPA is served from another origin.
CORS_ORIGIN=

# Reverse-proxy hops in front of Express (Dokploy's Traefik = 1). Wrong value
# = req.ip is the proxy and every client shares ONE rate-limit bucket.
TRUST_PROXY=1

# White-label — the host customers CNAME their own domain to. Verification
# fails without it. Must be the platform's public hostname.
PLATFORM_DOMAIN=wap.prominds.digital

# Dokploy API — lets a verified domain register itself so Traefik issues its
# certificate. Leave blank to add each domain by hand in the Dokploy UI.
# The API key comes from Dokploy → settings/profile → API/CLI.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_FRONTEND_APP_ID=
DOKPLOY_BACKEND_APP_ID=

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Queue + cache (point at your RabbitMQ / Redis services)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
WORKER_ENABLED=true
WORKER_SEND_DELAY_MS=50
WORKER_MAX_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=600

# Cloudinary (image uploads) — optional but needed for media campaigns
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (optional)
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=
