# ---- Backend environment (set these in Dokploy → application → Environment) ----

# Core
NODE_ENV=production
PORT=3050

# Database (use your managed Mongo or the Dokploy service hostname)
MONGO_URI=mongodb://user:pass@mongodb:27017
DB_NAME=whatsapp-campaigner

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# CORS — leave EMPTY for the same-origin deploy (nginx proxies /api to this
# service, so there is no cross-origin request to allow). Only set it if the
# frontend is genuinely served from a different origin.
CORS_ORIGIN=

# Reverse-proxy hops in front of Express. Dokploy's Traefik + the frontend's
# nginx = 2. Wrong value = every client shares one rate-limit bucket.
TRUST_PROXY=2

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Queue + cache (point at your RabbitMQ / Redis services)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
WORKER_ENABLED=true
WORKER_SEND_DELAY_MS=50
WORKER_MAX_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=600

# Cloudinary (image uploads) — optional but needed for media campaigns
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (optional)
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=
